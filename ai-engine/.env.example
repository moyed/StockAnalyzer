# AI Engine Environment Variables

# ============================================
# REQUIRED: Standard AI Endpoints
# ============================================
# Used by: /analyze, /project, /assess-macro-risk, /chat
GRADIENT_ACCESS_TOKEN=your_gradient_access_token_here
GRADIENT_MODEL_ID=kimi-k2.6

# ============================================
# OPTIONAL: Agentic Projection
# ============================================
# Used by: /project-agentic (autonomous research with tool calls)
# Get your key from: https://console.anthropic.com/
# If not set, agentic endpoints will return 503
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# Notes
# ============================================
# 1. Standard endpoints work without ANTHROPIC_API_KEY
# 2. Agentic endpoints require ANTHROPIC_API_KEY
# 3. Check /health to verify configuration
# 4. Rename this file to .env and fill in your keys
